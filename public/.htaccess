<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Força www.cotarme.com.br (evita redirecionamento indevido/loop)
  RewriteCond %{HTTP_HOST} ^cotarme\.com\.br$ [NC]
  RewriteRule ^(.*)$ https://www.cotarme.com.br/$1 [R=301,L]

  # Não reescreva requisições para arquivos, diretórios ou symlinks existentes
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l

  # Redireciona qualquer rota interna para o index.html (SPA)
  RewriteRule ^ index.html [QSA,L]
</IfModule>

# MIME types corretos
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/json .json .webmanifest
  AddType font/woff2 .woff2
</IfModule>

# Cache dos assets com hash
<IfModule mod_headers.c>
  <FilesMatch "\.(js|mjs|css|woff2|png|jpg|jpeg|svg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# Compressão
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

ErrorDocument 404 /index.html
